  InitFcn		  "% --- Inner loop gains --------\n%Kp_pitch = 2.5;   Kp_roll = 2.5;    Kp_yaw = 0.4;\n%Ki_pitch = 0.06;  "
  "Ki_roll = 0.055; Ki_yaw = 0.095;\n%Kd_pitch = 1.25; Kd_roll = 1.25;  Kd_yaw = 1.2;\n% --------------------------\n\n"
  "% --- Outer loop gains --------\nP_X=9.44;   I_X=0.23; D_X=2.36;\nP_Y=9.33;   I_Y=0.18; D_Y=1.54;\n%P_Z = 32; I_Z = "
  "5;  D_Z = 10;\n% --------------------------\n\n% --- Saturation limits --------\nattit_upper_limit = 10;\nattit_lowe"
  "r_limit = -10;\n\npos_upper_limit = 1;\npos_lower_limit = -1;\n\nmvel_upper_limit = 30;\nmvel_lower_limit = 5;\n% --"
  "------------------------\n\n%gera o valor do angulo \n%aleatoreamente para o treinamendo \n%de posicao\n%rand_ang = "
  "pi + (-pi-pi).*rand(1,1);\n%rand_altur = 1 + (3-1).*rand(1,1);\n\nglobal clientID;\nclientID=-1;"
  LastSavedArchitecture	  "glnxa64"
