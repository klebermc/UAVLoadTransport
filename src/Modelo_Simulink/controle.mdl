      LibraryVersion	      "1.69"
      RequestExecContextInheritance off
      Object {
	$PropName		"MaskObject"
	$ObjectID		21
	$ClassName		"Simulink.Mask"
	Description		"Animate quadrotor."
	Help			"This block graphically displays a quadrotor (flying robot).\n\nA new figure is created and A graphical model "
	"of a quadrotor is animated \nto a pose specified by the state vector input to the block.  \n\nThe state vector is [x "
	"y z roll pitch yaw] in world coordinates and the\nangles are in radians.\n\nNotes:\n- The dimensions of the vehicle w"
	"orkspace are set by parameters"
	Array {
	  Type			  "Simulink.MaskParameter"
	  Dimension		  3
	  Object {
	    $ObjectID		    22
	    Type		    "edit"
	    Name		    "quad"
	    Prompt		    "Model"
	    Value		    "quad"
	  }
	  Object {
	    $ObjectID		    23
	    Type		    "edit"
	    Name		    "xydim"
	    Prompt		    "xy-axes dimension"
	    Value		    "2"
	  }
	  Object {
	    $ObjectID		    24
	    Type		    "edit"
	    Name		    "zdim"
	    Prompt		    "z-axis dimension"
	    Value		    "10"
	  }
	  PropName		  "Parameters"
	}
      }
