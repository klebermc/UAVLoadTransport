  InitFcn		  "% --- Inner loop gains --------\n%Kp_roll = 0.05;\n%Kp_pitch = 0.05;\n%Kp_yaw = 0.2;\n\n%Ki_roll = 0.01;"
  "\n%Ki_pitch = 0.01;\n%Ki_yaw = 0.1;\n\n%Kd_roll = 0.004;\n%Kd_pitch = 0.004;\n%Kd_yaw = 0.04;\n\n%D_roll = 0.04;\n%D"
  "_pitch = 0.04;\n%D_yaw = 0.2;\n% --------------------------\n\n% --- Outer loop gains --------\nKp_altitude = 8;\nKp"
  "_pos_x = 10;\nKp_pos_y = 10;\n\nKi_altitude = 0.1;\nKi_pos_x = 5;\nKi_pos_y = 5;\n\nKd_altitude = 5;\nKd_pos_x = 5;\n"
  "Kd_pos_y = 5;\n% --------------------------\n\n% --- Saturation limits --------\npos_upper_limit = 1;\npos_lower_lim"
  "it = -1;\n\nmvel_upper_limit = 10;\nmvel_lower_limit = 0;\n% --------------------------\n\nglobal clientID;\nclientI"
  "D=-1;"
