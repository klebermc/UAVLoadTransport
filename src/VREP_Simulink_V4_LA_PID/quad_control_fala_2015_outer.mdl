  InitFcn		  "% --- Inner loop gains --------\nKp_pitch = 5;\nKp_roll = 3;\nKp_yaw = 0.4;\n\nKi_pitch = 0.06;\nKi_roll"
  " = 0.055;\nKi_yaw = 0.095;\n\nKd_pitch = 0.6;\nKd_roll = 0.8;\nKd_yaw = 1.2;\n% --------------------------\n\n% --- "
  "Outer loop gains --------\nP_X = 3.25;\nI_X = 0.45;\nD_X = 2;\n\nP_Y = 2.75;\nI_Y = 0.35;\nD_Y = 4.75;\n\n%P_Z = 6; "
  "I_Z = 0.1; D_Z = 2;\nP_Z = 20;\nI_Z = 0.5;\nD_Z = 5;\n% --------------------------\n\n% --- Saturation limits ------"
  "--\npos_upper_limit = 1;\npos_lower_limit = -1;\n\nmvel_upper_limit = 30;\nmvel_lower_limit = 5;\n% ----------------"
  "----------\n\n%gera o valor do angulo \n%aleatoreamente para o treinamendo \n%de posicao\nrand_ang = pi + (-pi-pi).*"
  "rand(1,1);\nrand_altur = 1 + (3-1).*rand(1,1);\n\nglobal clientID;\nclientID=-1;"
  LastSavedArchitecture	  "glnxa64"
